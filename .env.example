# Copy to .env for local dev. On Railway, set these as service variables instead —
# Railway's Postgres plugin provides DATABASE_URL automatically when you link it to this service.
DATABASE_URL="postgresql://user:password@localhost:5432/yardbuilt_dev"
JWT_SECRET="replace-with-a-long-random-value-before-any-real-deploy"
PORT=4000

# In-app assistant (Claude). Create a key at platform.claude.com → API Keys and set it in Railway's
# Variables tab. Leave unset to hide the assistant entirely. ASSISTANT_MODEL is optional.
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-sonnet-5-5"
